# Local demonstration only. Copy this file to .env before docker compose up.
# Use URL-safe letters and digits for MYSQL_USER, MYSQL_DATABASE and MYSQL_PASSWORD,
# because the application database URL interpolates them directly.
MYSQL_DATABASE=agriscan
MYSQL_USER=agriscan
MYSQL_PASSWORD=agriscanLocalDb2026
MYSQL_ROOT_PASSWORD=agriscanLocalRoot2026

WEB_PORT=8080
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Demo data are illustrative. No trained model is included.
DEMO_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
JWT_SECRET=local-demo-change-this-secret-before-production-2026

# For production: set DEMO_MODE=false, replace every password and JWT_SECRET,
# use a >=12-character ADMIN_PASSWORD and >=32-character random JWT_SECRET,
# and configure TLS, access controls, backups, and secrets management.

# Account registration and email verification (restart API after edits)
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) or ssl (465)
SMTP_SECURITY=starttls

# OpenAI-compatible provider; base URL includes /v1, NOT /chat/completions.
# API key remains on the server. Do not put it in frontend VITE_* variables.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# Inert weight storage; uploading does not load/execute .pt pickle content.
MODEL_MAX_UPLOAD_MB=200

# Validated ONNX model manifest; blank keeps sample collection mode.
MODEL_MANIFEST=
INFERENCE_THREADS=2
