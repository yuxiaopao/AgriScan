# Local development: native frontend/backend, Docker MySQL and Redis.
DATABASE_URL=mysql+pymysql://agriscan:agriscanLocalDb2026@127.0.0.1:13308/agriscan?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16380/0
DEMO_MODE=true
JWT_SECRET=agriscan-local-demo-secret-change-before-deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,https://localhost,http://localhost,capacitor://localhost

# Production example:
# DEMO_MODE=false
# DATABASE_URL=mysql+pymysql://agriscan:replace-password@127.0.0.1:13308/agriscan?charset=utf8mb4
# REDIS_URL=redis://127.0.0.1:16380/0
# JWT_SECRET=<random-secret-at-least-32-characters>
# ADMIN_PASSWORD=<unique-password-at-least-12-characters>

# Account registration and email verification (restart API after edits)
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) or ssl (465)
SMTP_SECURITY=starttls

# OpenAI-compatible provider; base URL includes /v1, NOT /chat/completions.
# API key remains on the server. Do not put it in frontend VITE_* variables.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# Inert weight storage; uploading does not load/execute .pt pickle content.
MODEL_MAX_UPLOAD_MB=200

# Validated ONNX model manifest; blank keeps sample collection mode.
MODEL_MANIFEST=../models/candidates/user-detect-fafc2bb3ce9e/manifest.json
INFERENCE_THREADS=2

# Independent Fernet key for write-only SMTP/LLM credentials saved by administrators.
# Generate with cryptography.fernet.Fernet.generate_key(); retain with database backups.
# Never use VITE_* or commit the real key. Required only when saving/reading encrypted credentials.
CONFIG_ENCRYPTION_KEY=
