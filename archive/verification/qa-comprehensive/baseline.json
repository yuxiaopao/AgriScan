      },
      {
        "id": "rice-scouting",
        "title": "水稻巡田，把观察变成可追溯的记录",
        "crop": "水稻",
        "category": "田间管理",
        "summary": "固定采样路线，记录叶色、病斑分布与水肥条件，便于对比长势。",
        "content": "在田块不同位置选择代表性样点，保持相近的拍摄距离与光线条件。记录日期、生育期、水层、叶色及异常植株的分布。对出现病斑的叶片同时拍摄近景与整株，避免把虫害、机械损伤或营养问题误判为同一种病害。结合连续巡检记录咨询农技人员。",
        "sources": [
          {
            "url": "https://education.irri.org/wp-content/uploads/2022/10/RD-v2.pdf",
            "title": "IRRI · Rice Doctor"
          }
        ],
        "image": null,
        "status": "published",
        "created_by": null,
        "updated_by": null,
        "created_at": "2026-10-28T11:01:11.592326+00:00",
        "updated_at": "2026-10-28T11:01:11.592326+00:00",
