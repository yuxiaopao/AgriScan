# Published models are versioned with Git LFS.
!models/pretrained/*.pt
!models/candidates/**/*.pt
!models/candidates/**/*.onnx
!models/releases/**/*.pt
!models/releases/**/*.onnx
!training/weights/*.pt
.logs/
.runtime/
*.log

